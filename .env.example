# Matter is mounted at ptoq.io/matter by default.
MATTER_BASE_PATH=/matter

# Fixture admission uses the same Matter 0.2 multipart route as live speech.
# The browser cannot choose this adapter; deployments select it here.
MATTER_TRANSCRIPTION_ADAPTER=fixture
MATTER_FIXTURE_ADMISSION_TRANSCRIPT=也许我还没有想清楚，但这句话可以先留在这里，等它继续长出自己的方向。

# Live transcription remains unavailable until its deployment rate, request,
# and spend guards are verified. The retired scene protocol is not configurable.

# Local production-build profiling only. The route is a 404 unless enabled.
MATTER_PERFORMANCE_FIXTURE=false
