# Matter is mounted at ptoq.io/matter by default. Set this to an empty value
# for a dedicated domain such as matter.ptoq.io, where the app owns `/`.
MATTER_BASE_PATH=/matter

# Use `root` only for the public dedicated-domain preview. It renders one
# initial thought; each visitor's subsequent material remains local to them.
# MATTER_INITIAL_DOCUMENT=root

# Canonical public origin for metadata, JSON-LD, sitemap, robots, and social
# images. Keep this to an origin only, without a path. The app uses the local
# origin in development and ptoq.io fallbacks in production when unset.
# MATTER_PUBLIC_ORIGIN=https://www.ptoq.io
# NEXT_PUBLIC_BASE_URL=https://www.ptoq.io

# Local fixture admission proves the multipart boundary only. Dedicated preview
# deployments use `browser`: native Web Speech first, with no fixture voice.
MATTER_TRANSCRIPTION_ADAPTER=fixture
MATTER_FIXTURE_ADMISSION_TRANSCRIPT=也许我还没有想清楚，但这句话可以先留在这里，等它继续长出自己的方向。
MATTER_FIXTURE_DIRECTION_TRANSCRIPT=把这里说得更具体一些，但保留一点不确定。

# `browser` is the public preview setting. It reports native browser recognition
# as available; the HTTP route still refuses fixture or unconfigured fallback.
# A deployment without a live STT service may enable the on-device fallback.
# It lazily downloads a quantized multilingual Whisper model only when native
# browser recognition is unavailable; audio remains on the person's device.
# NEXT_PUBLIC_MATTER_BROWSER_SPEECH_ENABLED=true
# NEXT_PUBLIC_MATTER_AUDIO_UPLOAD_ENABLED=true
# NEXT_PUBLIC_MATTER_LOCAL_TRANSCRIPTION_ENABLED=true

# Thought labels are always derived locally. This adapter only controls whether
# a model may improve one: `fixture` proves the path, `live` uses the pool
# below, `off` keeps the deterministic label. An unusable pool is not an error;
# it is a quieter interface, not a broken one.
MATTER_LABEL_ADAPTER=fixture
# MATTER_FIXTURE_LABEL pins one label for a deterministic browser test.

# Transcript repair restores recognition debris after the final transcript is
# already durable. Ordered local rules are always the floor; `fixture` proves
# one stronger proposal, `live` uses the pool below, and `off` keeps the rules.
# Every failure does the same thing, so an unusable provider costs a moment,
# never a thought.
MATTER_REPAIR_ADAPTER=fixture
# MATTER_FIXTURE_REPAIR pins one repaired transcript for a deterministic test.
# NEXT_PUBLIC_MATTER_TRANSCRIPT_REPAIR_ENABLED=false removes the round trip from
# a build without changing the server's own adapter.

# The lightweight inquiry has its own authority gate. `live` reuses the
# server-only pool below; leaving it unset keeps the honest unavailable state.
# MATTER_INQUIRY_ADAPTER=live

# Live pool. Ordered: the first healthy candidate answers, and a station that
# just failed is tried last rather than dropped. Each relay is one station with
# its own base URL, key, and ordered model list; a station missing a key or
# base URL is skipped without disturbing the others. Prefer a fast, cheap model
# first — on the label corpus a flash-class model matched a large model's
# acceptance at roughly a third of the latency.
# Base URLs must be their final OpenAI-compatible `/v1` location: redirects are
# refused so material and credentials never follow a relay elsewhere.
#
# Keys belong in .env.local, which is git-ignored. Never here.
#
# MATTER_MODEL_POOL=abc,backup
# MATTER_MODEL_ABC_BASE_URL=https://example.invalid/v1
# MATTER_MODEL_ABC_API_KEY=
# MATTER_MODEL_ABC_MODELS=Qwen-flash,DeepSeek-V3
# MATTER_MODEL_BACKUP_BASE_URL=https://other.invalid/v1
# MATTER_MODEL_BACKUP_API_KEY=
# MATTER_MODEL_BACKUP_MODELS=Qwen-flash
#
# AIPing is a separate station, not a model name added to another relay. Its
# current OpenAI-compatible endpoint and low-latency Matter candidate order:
# MATTER_MODEL_POOL=abc,aiping
# MATTER_MODEL_AIPING_BASE_URL=https://aiping.cn/api/v1
# MATTER_MODEL_AIPING_API_KEY=
# MATTER_MODEL_AIPING_MODELS=Qwen3.5-Flash,GLM-4.7-Flash
# MATTER_MODEL_AIPING_ENABLE_THINKING=false
#
# Existing deployments may keep the complete legacy `MATTER_LABEL_*` namespace.
# Use exactly one namespace: when both pool variables are non-empty, Matter
# fails closed instead of guessing which ordered candidates own live traffic.

# Local production-build profiling only. The route is a 404 unless enabled.
MATTER_PERFORMANCE_FIXTURE=false
