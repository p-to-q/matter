# Matter is mounted at ptoq.io/matter by default. Internal ARROW_* names remain
# stable during the product rename to avoid a configuration-breaking migration.
ARROW_BASE_PATH=/matter

# mock is deterministic and requires no network. openai uses server-side API calls.
ARROW_AGENT_ADAPTER=mock
ARROW_TRANSCRIPTION_ADAPTER=mock

# Required only when either adapter is set to openai.
OPENAI_API_KEY=
OPENAI_ARROW_MODEL=gpt-5.6-sol
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# Keeps ?demo=fixture available even when live adapters are configured.
ARROW_DEMO_FIXTURES=true

# Optional deterministic demo sentence.
ARROW_FIXTURE_TRANSCRIPT=人为什么会对从未经历过的时代产生怀旧？
ARROW_FIXTURE_TRANSFORM_TRANSCRIPT=把这种可能性说得更具体一些，但保留一点不确定。
